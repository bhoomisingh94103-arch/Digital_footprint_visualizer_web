# Digital Footprint Intelligence - Environment Configuration
# Copy this file to .env and fill in your values

# Flask Secret Key (generate a strong random string in production)
SECRET_KEY=dfv_cyber_jwt_secret_change_me_987654321

# Database Configuration (Defaults to local SQLite if left empty)
# PostgreSQL example: postgresql://user:password@localhost:5432/digital_footprint
DATABASE_URL=sqlite:///digital_footprint.db

# Flask Environment (development / testing / production)
FLASK_ENV=development
FLASK_DEBUG=1

# External API Keys (Optional integrations)
# Have I Been Pwned API Key (Optional, get one at https://haveibeenpwned.com/API/Key)
HIBP_API_KEY=

# EmailRep API Key (Optional, get one at https://emailrep.io/key)
EMAILREP_API_KEY=

# AI Chatbot Assistant (Optional - If omitted, intelligent rule-based expert engine is used)
# Provide either GEMINI_API_KEY or OPENAI_API_KEY
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMTP Email Configuration (For live OTP email delivery)
# If left empty, OTPs are printed to terminal console / dev flash notification for local testing
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@digitalfootprint.local

# OTP Settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

